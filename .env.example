# Copy to .env and fill in. Server env is validated at startup by src/shared/lib/env.ts.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security — generate with: openssl rand -hex 32
JWT_SECRET=

# MongoDB (docker compose up -d mongo)
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=app
MONGO_USER=
MONGO_PASSWORD=

# Redis (docker compose up -d redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=
# Optional: Sentinel mode, e.g. [{"host":"localhost","port":26379}]
REDIS_SENTINELS=

# Sentry — leave NEXT_PUBLIC_SENTRY_DSN empty to disable
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_PROFILES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
# Build-time source map upload (org auth token, sntrys_ prefix)
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# E2E (Playwright)
BASE_URL=http://localhost:3000
